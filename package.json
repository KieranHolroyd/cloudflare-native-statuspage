{
	"name": "cloudflare-native-statuspage",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler d1 migrations apply statuspage-db --remote && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"db:migrate": "wrangler d1 migrations apply statuspage-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply statuspage-db --remote"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260905.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.131.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.41.0",
		"@tanstack/svelte-query": "^6.1.48",
		"@tanstack/table-core": "^8.21.3",
		"better-auth": "^1.7.2",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260903.1": true
	}
}
